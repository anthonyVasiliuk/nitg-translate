{
    "name": "anthonyvasiliuk/nitg-translate",
    "description": "NITG Laravel Models Translation package",
    "type": "library",
    "require": {
        "laravel/framework": "^9",
        "matecat/xliff-parser": "^2.0"
    },
    "prefer-stable": true,
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nitg\\NitgTranslate\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Antony Vasiliuk",
            "email": "anthony.vbrest@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NITG\\NitgTranslate\\Providers\\NitgTranslateProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
